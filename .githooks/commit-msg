#!/bin/sh
# The first line of a commit message is a Conventional Commit (see CLAUDE.md). Merge and revert commits git writes pass.
first=$(head -n 1 "$1")
case "$first" in
	Merge\ *|Revert\ *) exit 0 ;;
esac
if ! printf '%s' "$first" | grep -Eq '^(feat|fix|docs|test|refactor|perf|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^ ].*[^.]$'; then
	echo "commit-msg: \"$first\" is not a Conventional Commit." >&2
	echo "  <type>(<scope>): <summary>      e.g. fix(backend): read checklist answers written [N/A]" >&2
	echo "  types: feat fix docs test refactor perf build ci chore revert" >&2
	exit 1
fi
