#!/bin/sh
# A commit message is a Conventional Commit and describes the change only (see CONTRIBUTING.md).
# Merge and revert commits that git writes pass.
first=$(head -n 1 "$1")
case "$first" in
	Merge\ *|Revert\ *) exit 0 ;;
esac
if ! printf '%s' "$first" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^ ].*[^.]$'; then
	echo "commit-msg: \"$first\" is not a Conventional Commit." >&2
	echo "  <type>(<scope>): <summary>      e.g. fix(backend): read checklist answers written [N/A]" >&2
	echo "  types: feat fix docs style refactor perf test build ci chore revert" >&2
	exit 1
fi
# no tool credits: not who or what wrote it
if grep -v '^#' "$1" | grep -Eiq '^co-authored-by:.*(claude|anthropic|copilot|chatgpt|openai|cursor|\bbot\b)|generated (with|by)|🤖'; then
	echo "commit-msg: the message credits a tool. Describe the change and nothing else." >&2
	exit 1
fi
# a key pasted into a message is published like any other
if grep -Eq 'sk-ant-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|hf_[A-Za-z0-9]{30,}|AKIA[0-9A-Z]{16}' "$1"; then
	echo "commit-msg: something shaped like a secret is in the message." >&2
	exit 1
fi
