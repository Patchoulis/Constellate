#!/bin/sh
# Refuse a commit that adds something shaped like a secret, or a file that must never be committed.
# Enabled by: git config core.hooksPath .githooks
# The shapes of secrets are in secrets.txt beside this file, one extended regular expression per line; the
# commit-msg hook and CI's secrets job read the same file.
secrets="$(dirname "$0")/secrets.txt"
if [ ! -s "$secrets" ]; then
	echo "pre-commit: $secrets is missing: nothing could be checked for secrets, so nothing is committed." >&2
	exit 1
fi
forbidden=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)(\.env(\..*)?|.*\.env|.*\.pem|.*\.key|.*\.p12|.*\.pfx|id_(rsa|dsa|ecdsa|ed25519)|settings\.local\.json)$|^data/' | grep -vE '(^|/)\.env\.example$')
if [ -n "$forbidden" ]; then
	echo "pre-commit: these files must not be committed:" >&2
	echo "$forbidden" >&2
	exit 1
fi
found=$(git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -En -f "$secrets" | cut -c1-60)
if [ -n "$found" ]; then
	echo "pre-commit: something shaped like a secret is staged (shown cut short):" >&2
	echo "$found" >&2
	echo "Remove it, and revoke the key if it was real." >&2
	exit 1
fi
# .env.example lists names only: a value after "=" on a line whose name looks secret does not belong in it
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '(^|/)\.env\.example$'; then
	filled=$(git show :.env.example | grep -E '^[A-Z_]*(KEY|TOKEN|SECRET|PASSWORD)[A-Z_]*=.+' | cut -d= -f1)
	if [ -n "$filled" ]; then
		echo "pre-commit: .env.example must not hold values for:" >&2
		echo "$filled" >&2
		exit 1
	fi
fi
# The prices and exchange rates compiled into the engine: a file the engine would refuse is not committed.
# The staged content is checked, not the working copy. It needs node: without it the commit is refused rather
# than let through unchecked.
prices=apps/engine/data/prices.json
if git diff --cached --name-only --diff-filter=ACMR | grep -qx "$prices"; then
	if ! command -v node >/dev/null 2>&1 || [ ! -f scripts/update-prices.mjs ]; then
		echo "pre-commit: $prices is staged, and checking it needs node and scripts/update-prices.mjs." >&2
		exit 1
	fi
	if ! git show ":$prices" | node scripts/update-prices.mjs --validate -; then
		echo "pre-commit: the staged $prices is not valid (above). scripts/update-prices.mjs writes it correctly." >&2
		exit 1
	fi
fi
