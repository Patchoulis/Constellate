{
	"name": "constellate",
	"version": "0.2.3",
	"private": true,
	"packageManager": "npm@11.20.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"setup": "node scripts/setup.mjs",
		"build": "node scripts/build.mjs",
		"app": "node scripts/build.mjs --run",
		"dist": "node scripts/build.mjs --dist",
		"dev": "node scripts/dev.mjs",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"pr": "node scripts/pr.mjs"
	},
	"overrides": {
		"minimatch@>=7.0.0 <11.0.1": "11.0.1"
	},
	"devDependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"prettier": "3.10.1",
		"turbo": "^2.5.0"
	}
}
