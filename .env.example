# Constellate's settings that come from the environment.
#
# Copy this file to `.env` (which git ignores) and fill in what you need, or set the same names as ordinary
# environment variables. Everything here has a safe default: the desktop app needs none of it.
# NEVER put a real value in this file: it is committed. Secrets live in `.env` or the environment only.

# ---------------------------------------------------------------- language model (names, descriptions, overviews)
# The key for the Claude API. Without it everything else works; communities are named by their terms.
ANTHROPIC_API_KEY=
# Where requests to the Claude API are sent. Leave unset for Anthropic's own endpoint.
ANTHROPIC_BASE_URL=

# ---------------------------------------------------------------- where the engine listens
# The address to listen on. The default is this computer only. Any other address is "network mode":
# HTTPS, a certificate and a login are then required (see below).
CONSTELLATE_BIND=127.0.0.1
# The port; 0 picks a free one.
CONSTELLATE_PORT=0
# The name people reach the engine by, when it listens on every address (0.0.0.0): requests for any other
# name are refused.
CONSTELLATE_HOST=
# The secret every request must carry. Generated at start in local mode; required (32+ characters) in network mode.
CONSTELLATE_TOKEN=
# The interface's exact origin, e.g. https://papers.example.org
CONSTELLATE_ORIGIN=

# ---------------------------------------------------------------- network mode only: HTTPS
# On by default. Setting this to false is an explicit opt-out that prints a warning at every start.
CONSTELLATE_USE_HTTPS=true
# The certificate and its private key, as PEM files.
CONSTELLATE_TLS_CERT=
CONSTELLATE_TLS_KEY=

# ---------------------------------------------------------------- network mode only: the owner's login
# Sign-in with Google (OpenID Connect): the client registered for this server, and the one account allowed in.
CONSTELLATE_OIDC_ISSUER=https://accounts.google.com
CONSTELLATE_OIDC_CLIENT_ID=
CONSTELLATE_OIDC_CLIENT_SECRET=
CONSTELLATE_OWNER_EMAIL=
# The secret that signs session cookies (32+ random characters).
CONSTELLATE_SESSION_SECRET=

# ---------------------------------------------------------------- where things are fetched from and kept
# The folder for the library and runs. The default is the app's own data folder.
CONSTELLATE_DATA=
# The Hugging Face endpoint the embedding model is downloaded from (a mirror, if you need one).
HF_ENDPOINT=https://huggingface.co
