# Constellate's settings that come from the environment.
#
# Copy this file to `.env` (which git ignores) and fill in what you need, or set the same names as ordinary
# environment variables. Everything here has a safe default: the desktop app needs none of it.
# NEVER put a real value in this file: it is committed. Secrets live in `.env` or the environment only.
#
# The engine reads `.env` from the folder it is started in. The desktop app starts it in its data folder, so the
# installed app's `.env` is there (Windows: %LOCALAPPDATA%\Constellate\data\.env; Linux:
# ~/.local/share/constellate/data/.env; from the repository: data/.env). The desktop app decides how its engine
# listens itself: in that `.env`, only the language model's names and CONSTELLATE_THREADS matter.
#
# Not set by hand: the desktop shell gives the interface's server the engine's address and token in
# CONSTELLATE_ENGINE and CONSTELLATE_ENGINE_TOKEN (apps/desktop/engine.cjs, apps/web/proxy.ts).

# ---------------------------------------------------------------- language model (names, descriptions, overviews)
# The provider and model are chosen in the app's settings; set the key of the provider chosen. Without any,
# everything else works and communities are named by their terms. An address must be https, or http to this
# computer only (localhost, 127.0.0.1, [::1]).
#
# Anthropic (the Claude API). The base URL is for a proxy or gateway; leave unset for Anthropic's own endpoint.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# OpenAI. The base URL ends in /v1 as OpenAI's own does; leave unset for https://api.openai.com/v1.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Google Gemini. Leave the base URL unset for https://generativelanguage.googleapis.com.
GEMINI_API_KEY=
GEMINI_BASE_URL=
# Any OpenAI-compatible server: its address ending in /v1, e.g. Ollama http://localhost:11434/v1, LM Studio
# http://localhost:1234/v1, or a hosted gateway; its key only if it needs one. JSON=prompt for a server that
# refuses a JSON schema (the schema is then asked for in the question and checked); unset or schema sends it.
CONSTELLATE_MODEL_BASE_URL=
CONSTELLATE_MODEL_API_KEY=
CONSTELLATE_MODEL_JSON=
# Hosted providers reached through their own OpenAI-compatible APIs, each key under the name its documentation uses.
OPENROUTER_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
ZAI_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=
AI_GATEWAY_API_KEY=
BASETEN_API_KEY=
META_API_KEY=

# ---------------------------------------------------------------- where the engine listens
# The address to listen on. The default is this computer only. Any other address is "network mode":
# HTTPS, a certificate and a login are then required (see below).
CONSTELLATE_BIND=127.0.0.1
# The port; 0 picks a free one.
CONSTELLATE_PORT=0
# The name people reach the engine by, when it listens on every address (0.0.0.0): requests for any other
# name are refused.
CONSTELLATE_HOST=
# Network mode behind a reverse proxy: the proxy's IP addresses, separated by commas. A request from one of them
# is counted (for the limits on wrong tokens and sign-in attempts) against the client its X-Forwarded-For names
# (the right-most address that is not one of these). Unset: the header is never looked at.
CONSTELLATE_TRUSTED_PROXIES=
# The names the interface's own server is reached by, besides this computer's (127.0.0.1, localhost), separated by
# commas: on a server, the name people open (papers.example.org). Requests for any other name are refused.
CONSTELLATE_WEB_HOSTS=
# The secret every request must carry on this computer (generated at start when unset). Across a network the owner
# signs in instead, and this token (32+ characters) is accepted for programs only with CONSTELLATE_ALLOW_TOKEN=true.
CONSTELLATE_TOKEN=
# Network mode only: true lets programs use CONSTELLATE_TOKEN instead of signing in. Off by default.
CONSTELLATE_ALLOW_TOKEN=
# The interface's exact origin, e.g. https://papers.example.org. Required in network mode: it is where the owner
# signs in, and the provider sends the browser back to <origin>/auth/callback.
CONSTELLATE_ORIGIN=

# ---------------------------------------------------------------- network mode only: HTTPS
# On by default. Setting this to false is an explicit opt-out that prints a warning at every start.
CONSTELLATE_USE_HTTPS=true
# The certificate and its private key, as PEM files.
CONSTELLATE_TLS_CERT=
CONSTELLATE_TLS_KEY=

# ---------------------------------------------------------------- network mode only: the owner's login
# Sign-in with Google (OpenID Connect): the client registered for this server, and the one account allowed in.
# Another OpenID Connect provider works by changing the issuer.
CONSTELLATE_OIDC_ISSUER=https://accounts.google.com
CONSTELLATE_OIDC_CLIENT_ID=
CONSTELLATE_OIDC_CLIENT_SECRET=
# The owner's address, written as the provider shows it: the only account allowed to sign in.
CONSTELLATE_OWNER_EMAIL=
# true also lets the owner sign in with a password. At the first start the engine prints a one-time setup code on
# standard error to set it with; it is kept only as an Argon2id hash in the data folder.
CONSTELLATE_ALLOW_PASSWORD=
# (No session secret is needed: sessions are random ids kept in the engine's memory, not signed cookies.)

# ---------------------------------------------------------------- where things are fetched from and kept
# The folder for the library and runs. The default is the app's own data folder.
CONSTELLATE_DATA=

# ---------------------------------------------------------------- how much of the computer the engine uses
# The most threads the engine computes on (the similarity graph, communities, reading PDFs). The default is every
# core; a smaller number leaves the rest of the computer to other work while a run is computed.
CONSTELLATE_THREADS=
# The Hugging Face endpoint the embedding model is downloaded from (a mirror, if you need one). Read by the engine's
# model download (apps/engine/src/pipeline/model_files.rs) from the environment only, not from .env.
HF_ENDPOINT=https://huggingface.co
